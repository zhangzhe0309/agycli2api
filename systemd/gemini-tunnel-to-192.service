[Unit]
Description=Persistent Gemini Bridge Tunnel (104 -> 192:3404)
After=network.target hermes-gemini-bridge.service
Requires=hermes-gemini-bridge.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -N -o StrictHostKeyChecking=no -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 3404:127.0.0.1:3404 root@192.3.248.147
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
